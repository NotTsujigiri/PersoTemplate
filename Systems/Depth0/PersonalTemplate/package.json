{
  "name": "@perso/template",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "scripts": {
    "build": "npm run check:types --prefix ../../.. && tsc -p tsconfig.runtime.json && tsc -p tsconfig.json",
    "test": "npm run check:types --prefix ../../.. && node --experimental-strip-types --test \"*.test.ts\"",
    "test:browser": "npm run check:types --prefix ../../.. && playwright test -c playwright.config.ts"
  },
  "exports": {
    "./configuration": {"types":"./dist/configuration.d.ts","import":"./dist/configuration.js"},
    "./application/source": "./Depth0/Template/application.ts",
    ".": {
      "types": "./dist/Depth0/Template/application.d.ts",
      "import": "./dist/Depth0/Template/application.js"
    },
    "./channels/source": "./Depth0/Template/channels.ts",
    "./vault": {
      "types": "./dist/vault.d.ts",
      "import": "./dist/vault.js"
    }
  },
  "files": [
    "dist",
    "Depth0/Template",
    "tsconfig.json",
    "vault.ts"
  ],
  "dependencies": {
    "@btr/template": "file:../../../../../Btr/BtrTemplate",
    "@super-app/application": "file:../../../../../Btr/TheBroccoli/Systems/Depth6/Application",
    "@super-app/default-super-app-template": "file:../../../../../Btr/TheBroccoli/Systems/Depth3/DefaultSuperAppTemplate",
    "@super-app/relational-ui-contributor": "file:../../../../../Btr/TheBroccoli/Systems/Depth2/RelationalUi",
    "@super-app/relational-engine": "file:../../../../../Btr/TheBroccoli/Systems/Depth0/RelationalEngine"
  },
  "devDependencies": {
    "@playwright/test": "1.62.1",
    "@super-app/relational-engine-web-bridge-contributor": "file:../../../../../Btr/TheBroccoli/Systems/Depth1/RelationalEngineWebBridge",
    "typescript": "^5.9.2",
    "@types/node": "24.19.1",
    "bun-types": "1.4.2"
  },
  "broccoli": {
    "compositionRoot": "../../.."
  }
}
