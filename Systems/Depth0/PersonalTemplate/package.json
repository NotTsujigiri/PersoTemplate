{
  "name": "@perso/template",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "scripts": {
    "build": "npm run check:types --prefix ../../.. && tsc -p tsconfig.json && esbuild Depth0/Template/index.ts --bundle --format=esm --platform=browser --outfile=dist/index.js",
    "test": "npm run check:types --prefix ../../.. && node --experimental-strip-types --test vault.test.ts"
  },
  "exports": {
    ".": {
      "types": "./dist/Depth0/Template/index.d.ts",
      "import": "./dist/index.js"
    },
    "./channels/source": "./Depth0/Template/channels.ts",
    "./vault": {
      "types": "./dist/vault.d.ts",
      "import": "./dist/vault.js"
    }
  },
  "files": [
    "dist",
    "Depth0/Template",
    "tsconfig.json",
    "vault.ts"
  ],
  "dependencies": {
    "@super-app/default-super-app-template": "file:../../../../../Btr/TheBroccoli/Systems/Depth2/DefaultSuperAppTemplate",
    "@super-app/relational-ui-contributor": "file:../../../../../Btr/TheBroccoli/Systems/Depth1/RelationalUi",
    "@super-app/relational-engine": "file:../../../../../Btr/TheBroccoli/Systems/Depth0/RelationEngine"
  },
  "devDependencies": {
    "typescript": "^5.9.2",
    "esbuild": "0.28.1",
    "@types/node": "24.19.1"
  },
  "superAppTemplate": {
    "id": "personal",
    "label": "Perso",
    "entry": "dist/index.js",
    "sourceEntry": "Depth0/Template/index.ts",
    "assets": [],
    "sources": [
      "package.json",
      "tsconfig.json",
      "Depth0/Template/index.ts",
      "Depth0/Template/channels.ts",
      "Depth0/Template/profile-fields.ts",
      "Depth0/Template/profile-values.ts"
    ]
  },
  "broccoli": {
    "compositionRoot": "../../.."
  }
}
