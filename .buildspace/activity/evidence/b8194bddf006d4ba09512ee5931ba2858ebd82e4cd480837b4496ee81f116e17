index 0000000..d3f65c4
--- /dev/null
+++ b/Systems/Depth2/Json/classification.ts
@@ -0,0 +1,78 @@
+import { SyntaxKind } from "jsonc-parser";
+
+export type JsonTokenType = "property" | "string" | "number" | "boolean" | "null" | "operator" | "comment";
+type Mode = "root" | "done" | "array" | "array-recovery" | "key" | "colon" | "colon-newline" | "value" | "object-recovery";
+/** Persistent syntax context, independent of offsets, values, schemas and tree allocation. */
+export interface JsonContext {
+  readonly mode: Mode;
+  readonly parent?: JsonContext;
+}
+export const initialContext: JsonContext = {mode:"root"};
+const done: JsonContext = {mode:"done"};
+function mode(context: JsonContext, next: Mode): JsonContext {
+  return context.mode === next ? context : {mode: next, ...(context.parent ? {parent:context.parent} : {})};
+}
+export function sameContext(left: JsonContext, right: JsonContext): boolean {
+  let a: JsonContext | undefined = left, b: JsonContext | undefined = right;
+  while (a !== b) {
+    if (!a || !b || a.mode !== b.mode) return false;
+    a = a.parent;
+    b = b.parent;
+  }
+  return true;
+}
+function value(context: JsonContext, kind: SyntaxKind): JsonContext {
+  const parent = context.mode === "root" ? done : context.mode === "array" ? context : mode(context,"key");
+  switch (kind) {
+    case SyntaxKind.OpenBraceToken: return {mode:"key",parent};
+    case SyntaxKind.OpenBracketToken: return {mode:"array",parent};
+    case SyntaxKind.StringLiteral:
+    case SyntaxKind.NumericLiteral:
+    case SyntaxKind.NullKeyword:
+    case SyntaxKind.TrueKeyword:
+    case SyntaxKind.FalseKeyword: return parent;
+    default: return context.mode === "root" ? done : mode(context, context.mode === "array" ? "array-recovery" : "object-recovery");
+  }
+}
+/** Track only the context needed to distinguish keys, including incomplete JSON recovery. */
+export function classify(context: JsonContext, kind: SyntaxKind): {type: JsonTokenType | undefined; next: JsonContext} {
+  let next = context;
+  const isString = kind === SyntaxKind.StringLiteral;
+  const isKey = isString && (context.mode === "key" || context.mode === "colon-newline");
+  const type = tokenType(kind, isKey);
+  if (kind === SyntaxKind.Trivia || kind === SyntaxKind.LineCommentTrivia || kind === SyntaxKind.BlockCommentTrivia || kind === SyntaxKind.LineBreakTrivia) return {type,next};
+  if (context.mode === "done") return {type,next};
+  if (context.mode === "root") return {type,next:value(context,kind)};
+  const array = context.mode === "array" || context.mode === "array-recovery";
+  if (kind === (array ? SyntaxKind.CloseBracketToken : SyntaxKind.CloseBraceToken)) return {type,next:context.parent ?? done};
+  if (kind === SyntaxKind.CommaToken) return {type,next:mode(context,array ? "array" : "key")};
+  if (context.mode === "object-recovery" || context.mode === "array-recovery") return {type,next};
+  if (context.mode === "key") next = isString || kind === SyntaxKind.Unknown ? mode(context,"colon") : mode(context,"object-recovery");
+  else if (context.mode === "colon" || context.mode === "colon-newline") {
+    if (kind === SyntaxKind.ColonToken) next = mode(context,"value");
+    else if (isKey) next = mode(context,"colon");
+    else next = value(context,kind);
+  } else next = value(context,kind);
+  return {type,next};
+}
+export function afterNewline(context: JsonContext): JsonContext {
+  return context.mode === "colon" ? mode(context,"colon-newline") : context;
+}
+function tokenType(kind: SyntaxKind, key: boolean): JsonTokenType | undefined {
+  switch (kind) {
+    case SyntaxKind.StringLiteral: return key ? "property" : "string";
+    case SyntaxKind.NumericLiteral: return "number";
+    case SyntaxKind.TrueKeyword:
+    case SyntaxKind.FalseKeyword: return "boolean";
+    case SyntaxKind.NullKeyword: return "null";
+    case SyntaxKind.OpenBraceToken:
+    case SyntaxKind.CloseBraceToken:
+    case SyntaxKind.OpenBracketToken:
+    case SyntaxKind.CloseBracketToken:
+    case SyntaxKind.ColonToken:
+    case SyntaxKind.CommaToken: return "operator";
+    case SyntaxKind.LineCommentTrivia:
+    case SyntaxKind.BlockCommentTrivia: return "comment";
+    default: return undefined;
+  }
+}
