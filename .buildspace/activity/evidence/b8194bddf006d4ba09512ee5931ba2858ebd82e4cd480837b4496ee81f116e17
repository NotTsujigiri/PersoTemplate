+import test from "node:test";
+import assert from "node:assert/strict";
+import { mkdtemp, mkdir, writeFile, realpath, rm } from "node:fs/promises";
+import os from "node:os";
+import path from "node:path";
+import { pathToFileURL } from "node:url";
+import { createJsonServer } from "./server.ts";
+import { jsonTokens, encodeJsonTokens, type JsonClassificationWork } from "./tokens.ts";
+import { record } from "@super-app/lsp-contributor/contract/source";
+
+test("local JSON edits reuse classification of the unchanged document", async () => {
+  const directory = await mkdtemp(path.join(os.tmpdir(), "json-incremental-"));
+  const file = path.join(directory, "large.json"), uri = pathToFileURL(file).href;
+  const input = "{\n" + Array.from({length: 10000}, (_, index) => `  "key${index}": ${index}`).join(",\n") + "\n}";
+  const work: JsonClassificationWork[] = [];
+  const server = createJsonServer(pathToFileURL(await realpath(directory)).href, item => work.push(item));
+  const expected = { initialWholeScan: true, editScansLessThan4096Characters: true, editReusesOver90Percent: true, sameAsFreshClassification: true, cachedRequestDoesNoClassification: true };
+  try {
+    await writeFile(file, input);
+    await server.request("initialize", {});
+    await server.notify("textDocument/didOpen", {textDocument: {uri, languageId: "json", version: 1, text: input}});
+    await server.request("textDocument/semanticTokens/full", {textDocument:{uri}});
+    const first = work.at(-1);
+    const replacement = "40000", start = {line: 5001, character: 13}, end = {line: 5001, character: 17};
+    assert.equal(input.split("\n")[5001], '  "key5000": 5000,');
+    // The numeral starts at UTF-16 character 13 and is four characters wide.
+    await server.notify("textDocument/didChange", {textDocument: {uri, version: 2}, contentChanges: [{range: {start, end}, text: replacement}]});
+    const changed = record(await server.request("textDocument/semanticTokens/full", {textDocument: {uri}}));
+    const edited = input.replace('"key5000": 5000', '"key5000": 40000'), after = work.at(-1);
+    const expectedTokens = encodeJsonTokens(jsonTokens({uri, languageId:"json", version:2, text:edited}));
+    const calls = work.length;
+    await server.request("textDocument/semanticTokens/full", {textDocument: {uri}});
+    const actual = {
+      initialWholeScan: first?.scannedCharacters === input.length,
+      editScansLessThan4096Characters: !!after && after.scannedCharacters < 4096,
+      editReusesOver90Percent: !!after && after.reusedCharacters > input.length * 0.9,
+      sameAsFreshClassification: JSON.stringify(changed["data"]) === JSON.stringify(expectedTokens),
+      cachedRequestDoesNoClassification: work.length === calls,
+    };
+    const output = new URL(`./test-results/incremental/run-${Date.now()}/`, import.meta.url);
+    await mkdir(output, {recursive:true});
+    await writeFile(new URL("recording.json", output), JSON.stringify({input:{text:input, edit:{start,end,text:replacement}}, expected, actual, work}, null, 2));
+    assert.deepEqual(actual, expected);
+  } finally {
+    await server.close();
+    await rm(directory, {recursive:true, force:true});
+  }
+});
