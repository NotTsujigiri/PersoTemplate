{
  "name": "@perso/app",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "workspaces": [
    "Systems/Depth0/PersonalTemplate",
    "Systems/Depth0/Acceptance"
  ],
  "scripts": {
    "start": "powershell -NoProfile -File ./start-service.ps1",
    "test": "npm run check:types && npm run test --workspace @perso/acceptance",
    "service": "relational-engine-node-js-service relational-host.json",
    "stop": "powershell -NoProfile -File ./stop-service.ps1",
    "build": "npm run check:types && npm run check:organisation && npm run build --workspace @perso/template",
    "check:organisation": "check-system-organisation",
    "check:types": "check-type-safety",
    "check:components:single-file": "check-web-components single-file . .harness/component-checks",
    "check:components:identity": "check-web-components identity . .harness/component-checks",
    "check:components:construction": "check-web-components construction . .harness/component-checks",
    "check:components:empty-default": "check-web-components empty-default . .harness/component-checks",
    "check:components:lit": "check-web-components lit . .harness/component-checks",
    "check:components:decorators": "check-web-components decorators . .harness/component-checks",
    "check:components:element-interfaces": "check-web-components element-interfaces . .harness/component-checks",
    "check:components:documentation": "check-web-components documentation . .harness/component-checks"
  },
  "dependencies": {
    "@btr/template": "file:../../Btr/BtrTemplate/.runtime/decisions-review-release/btr-template-0.1.0.tgz",
    "@perso/template": "0.1.0",
    "@super-app/relational-engine-node-js-service": "file:../../Btr/TheBroccoli/.runtime/decisions-review-packages/super-app-relational-engine-node-js-service-0.1.0.tgz",
    "@super-app/relational-ui-browser-app": "file:../../Btr/TheBroccoli/.runtime/decisions-review-packages/super-app-relational-ui-browser-app-0.1.0.tgz",
    "@super-app/relational-ui-contributor": "file:../../Btr/TheBroccoli/.runtime/decisions-review-packages/super-app-relational-ui-contributor-0.1.0.tgz",
    "@super-app/default-super-app-template": "file:../../Btr/TheBroccoli/.runtime/decisions-review-packages/super-app-default-super-app-template-0.1.0.tgz",
    "@super-app/relational-engine-web-bridge-contributor": "file:../../Btr/TheBroccoli/.runtime/decisions-review-packages/super-app-relational-engine-web-bridge-contributor-0.1.0.tgz",
    "@super-app/filesystem-contributor": "file:../../Btr/TheBroccoli/.runtime/decisions-review-packages/super-app-filesystem-contributor-0.1.0.tgz",
    "@super-app/typescript-contributor": "file:../../Btr/TheBroccoli/.runtime/authoring-ready-packages/super-app-typescript-contributor-0.1.0.tgz",
    "@super-app/repository-organisation": "file:../../Btr/TheBroccoli/.runtime/decisions-review-packages/super-app-repository-organisation-0.1.0.tgz",
    "@super-app/harness-contributor": "file:../../Btr/TheBroccoli/.runtime/decisions-review-packages/super-app-harness-contributor-0.1.0.tgz",
    "@super-app/systems-engineering-contributor": "file:../../Btr/TheBroccoli/.runtime/decisions-review-packages/super-app-systems-engineering-contributor-0.1.0.tgz",
    "@super-app/tagging-contributor": "file:../../Btr/TheBroccoli/.runtime/decisions-review-packages/super-app-tagging-contributor-0.1.0.tgz"
  },
  "devDependencies": {
    "@super-app/web-component-contributor": "file:../../Btr/TheBroccoli/Systems/Depth1/WebComponent",
    "@super-app/project-tools": "file:../../Btr/TheBroccoli/Systems/Depth0/ProjectTools"
  },
  "broccoli": {
    "checks": {
      "check:components:element-interfaces": {"name":"Concrete element types"},
      "check:components:decorators": {"name":"Components use Lit decorators"},
      "check:components:single-file": {"name": "One component per file"},
      "check:components:identity": {"name": "Custom element identity"},
      "check:components:construction": {"name": "Construction without arguments"},
      "check:components:empty-default": {"name": "Visible without supplied data"},
      "check:components:lit": {"name": "Components use Lit"},
      "check:organisation": {
        "name": "Repository structure"
      },
      "test": {
        "name": "Acceptance tests"
      },
      "check:types": {
        "name": "Type safety"
      }
    }
  }
}
