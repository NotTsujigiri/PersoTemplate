{
  "name": "@perso/template-workspace",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "workspaces": [
    "Systems/Depth0/PersonalTemplate"
  ],
  "scripts": {
    "test": "npm run check:types && npm run test --workspace @perso/template",
    "test:browser": "npm run test:browser --workspace @perso/template",
    "build": "npm run check:types && npm run check:organisation && npm run build --workspace @perso/template",
    "check:organisation": "check-system-organisation",
    "check:types": "node Systems/Depth0/PersonalTemplate/generate-browser-types.ts && check-type-safety",
    "check:components:single-file": "check-web-components single-file . .harness/component-checks",
    "check:components:identity": "check-web-components identity . .harness/component-checks",
    "check:components:construction": "check-web-components construction . .harness/component-checks",
    "check:components:empty-default": "check-web-components empty-default . .harness/component-checks",
    "check:components:lit": "check-web-components lit . .harness/component-checks",
    "check:components:decorators": "check-web-components decorators . .harness/component-checks",
    "check:components:element-interfaces": "check-web-components element-interfaces . .harness/component-checks",
    "check:components:documentation": "check-web-components documentation . .harness/component-checks"
  },
  "dependencies": {
    "@perso/template": "0.1.0"
  },
  "devDependencies": {
    "@super-app/system-engineering-contributor": "file:../../Btr/TheBroccoli/Systems/Depth4/SystemEngineering",
    "@super-app/project-tools": "file:../../Btr/TheBroccoli/Systems/Depth0/ProjectTools"
  },
  "broccoli": {
    "checks": {
      "check:components:element-interfaces": {
        "name": "Concrete element types"
      },
      "check:components:decorators": {
        "name": "Components use Lit decorators"
      },
      "check:components:single-file": {
        "name": "One component per file"
      },
      "check:components:identity": {
        "name": "Custom element identity"
      },
      "check:components:construction": {
        "name": "Construction without arguments"
      },
      "check:components:empty-default": {
        "name": "Visible without supplied data"
      },
      "check:components:lit": {
        "name": "Components use Lit"
      },
      "check:organisation": {
        "name": "Repository structure"
      },
      "test": {
        "name": "Personal data contributor tests"
      },
      "check:types": {
        "name": "Type safety"
      }
    }
  }
}
