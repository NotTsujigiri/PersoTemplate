{
  "name": "@perso/template-workspace",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "engines": {
    "node": "24.22.3"
  },
  "workspaces": [
    "Systems/Depth0/PersonalTemplate"
  ],
  "scripts": {
    "start": "node Systems/Depth0/PersonalTemplate/runtime.ts start",
    "stop": "node Systems/Depth0/PersonalTemplate/runtime.ts stop",
    "mcp:register": "node Systems/Depth0/PersonalTemplate/runtime.ts register-mcp-client",
    "test": "run-checks steps:test",
    "steps:test": "npm run check:types && npm --workspace @perso/template run test",
    "test:browser": "run-checks -- npm --workspace @perso/template run test:browser",
    "build": "run-checks steps:build",
    "steps:build": "npm run check:types && npm run check:organisation && npm --workspace @perso/template run build",
    "check:organisation": "run-checks -- check-system-organisation",
    "check:types": "run-checks steps:check:types",
    "steps:check:types": "node Systems/Depth0/PersonalTemplate/generate-browser-types.ts && check-type-safety",
    "check:components:single-file": "run-checks -- check-web-components single-file .",
    "check:components:identity": "run-checks -- check-web-components identity .",
    "check:components:construction": "run-checks -- check-web-components construction .",
    "check:components:empty-default": "run-checks -- check-web-components empty-default .",
    "check:components:lit": "run-checks -- check-web-components lit .",
    "check:components:decorators": "run-checks -- check-web-components decorators .",
    "check:components:element-interfaces": "run-checks -- check-web-components element-interfaces .",
    "check:components:documentation": "run-checks -- check-web-components documentation ."
  },
  "dependencies": {
    "@perso/template": "0.1.0"
  },
  "devDependencies": {
    "@super-app/application": "file:../../Btr/TheBroccoli/Systems/Depth6/Application",
    "@super-app/system-engineering-contributor": "file:../../Btr/TheBroccoli/Systems/Depth4/SystemEngineering"
  },
  "broccoli": {
    "checks": {
      "check:components:element-interfaces": {
        "name": "Concrete element types"
      },
      "check:components:decorators": {
        "name": "Components use Lit decorators"
      },
      "check:components:single-file": {
        "name": "One component per file"
      },
      "check:components:identity": {
        "name": "Custom element identity"
      },
      "check:components:construction": {
        "name": "Construction without arguments"
      },
      "check:components:empty-default": {
        "name": "Visible without supplied data"
      },
      "check:components:lit": {
        "name": "Components use Lit"
      },
      "check:organisation": {
        "name": "Repository structure"
      },
      "test": {
        "name": "Personal data contributor tests"
      },
      "check:types": {
        "name": "Type safety"
      }
    }
  }
}
